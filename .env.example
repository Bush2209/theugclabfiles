# Client-side signals endpoint. /api/signals is the built-in Vercel Function.
VITE_SIGNALS_ENDPOINT=/api/signals

# Server-only. Never prefix these with VITE_ — they must not reach the browser.
# Set them in Vercel as Config / Secret respectively (see README).
